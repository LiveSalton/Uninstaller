<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    android:orientation="vertical"
    tools:context=".ThemeSettingActivity">

    <!-- 顶部标题栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="@color/title_bar_background">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@mipmap/back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/theme_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />
    </RelativeLayout>

    <!-- 主题选项 -->
    <RadioGroup
        android:id="@+id/rg_theme_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <!-- 跟随系统选项 -->
        <RadioButton
            android:id="@+id/rb_theme_system"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?android:attr/selectableItemBackground"
            android:button="@null"
            android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
            android:drawablePadding="16dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="@string/settings_theme_system"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="16dp"
            android:background="@color/divider" />

        <!-- 开启夜间模式选项 -->
        <RadioButton
            android:id="@+id/rb_theme_dark"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?android:attr/selectableItemBackground"
            android:button="@null"
            android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
            android:drawablePadding="16dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="@string/settings_theme_dark"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="16dp"
            android:background="@color/divider" />

        <!-- 关闭夜间模式选项 -->
        <RadioButton
            android:id="@+id/rb_theme_light"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?android:attr/selectableItemBackground"
            android:button="@null"
            android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
            android:drawablePadding="16dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="@string/settings_theme_light"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />
    </RadioGroup>

</LinearLayout> 