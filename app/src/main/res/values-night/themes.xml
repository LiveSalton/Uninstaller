<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 夜间模式的应用主题 -->
    <style name="Theme.Uninstaller" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:windowBackground">@color/background_primary</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
    </style>

    <style name="ActionBar.BlackWhite.Night" parent="android:Widget.Material.ActionBar.Solid">
        <item name="android:background">@color/title_bar_background</item>
        <item name="android:titleTextStyle">@style/ActionBarTitle.BlackWhite.Night</item>
    </style>

    <style name="ActionBarTitle.BlackWhite.Night" parent="android:TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textColor">@color/title_bar_text</item>
    </style>
</resources> 